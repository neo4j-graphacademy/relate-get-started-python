#!/usr/bin/env bash
# lab-reset: put the lab folder back to its starting state.
#
#   lab-reset          empty the lab folder (asks first)
#   lab-reset -y       empty it without asking
#   lab-reset --init   create the folder if missing; delete nothing
#
# Emptying the folder also removes any virtual environment you made in it.
# The relate package that came with the lab stays installed.
set -euo pipefail

LAB_DIR="${LAB_DIR:-}"
assume_yes=0
init_only=0

usage() {
  sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
}

for arg in "$@"; do
  case "${arg}" in
    -y | --yes) assume_yes=1 ;;
    --init) init_only=1 ;;
    -h | --help) usage; exit 0 ;;
    *) echo "lab-reset: unknown option: ${arg}" >&2; usage >&2; exit 2 ;;
  esac
done

# Refuse to run against anything that is not clearly the lab folder.
if [ -z "${LAB_DIR}" ]; then
  echo "lab-reset: LAB_DIR is not set. Rebuild the Codespace, or run: export LAB_DIR=/workspaces/<repo>/lab" >&2
  exit 1
fi
case "${LAB_DIR}" in
  /*/lab) ;;
  *) echo "lab-reset: LAB_DIR must be an absolute path ending in /lab, got: ${LAB_DIR}" >&2; exit 1 ;;
esac

mkdir -p "${LAB_DIR}"

if [ "${init_only}" -eq 1 ]; then
  echo "lab-reset: lab folder ready at ${LAB_DIR}"
  exit 0
fi

if [ "${assume_yes}" -ne 1 ]; then
  if [ ! -t 0 ]; then
    echo "lab-reset: not a terminal. Run 'lab-reset -y' to confirm." >&2
    exit 1
  fi
  echo "This deletes everything in ${LAB_DIR}: your scripts, team.rl and any virtual environment."
  printf 'Continue? [y/N] '
  read -r answer
  case "${answer}" in
    y | Y | yes | YES) ;;
    *) echo "lab-reset: nothing changed"; exit 0 ;;
  esac
fi

# .gitkeep stays so the folder survives in git. Everything else goes.
find "${LAB_DIR}" -mindepth 1 ! -name '.gitkeep' -delete

echo "lab-reset: ${LAB_DIR} is back to its starting state"
echo "lab-reset: now run this so your terminal is in a folder that exists:"
echo "    deactivate 2>/dev/null; cd \"\$LAB_DIR\""
